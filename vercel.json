{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?_path=/$1" },
    { "source": "/", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "insurance_claims/fixtures/**"
    }
  }
}
